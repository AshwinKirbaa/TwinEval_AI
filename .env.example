# TwinEval AI configuration
# Network server settings
# 0.0.0.0 allows other computers on the same network to access this server.
HOST=0.0.0.0
PORT=5000

# SQLite: portable local database. No MySQL server is required.
# Relative paths are resolved from the project root.
DB_PATH=./database/twineval.db

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Real email verification. Use an SMTP mailbox/app password; never commit
# the real password to source control.
PUBLIC_APP_URL=http://localhost:5000
# For Gmail, SMTP_HOST defaults to smtp.gmail.com and may be omitted.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-real-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=TwinEval AI <your-real-email@example.com>

# Google Identity Services OAuth 2.0 Web Client ID. Add your local and
# deployed site URLs as Authorized JavaScript origins in Google Cloud.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# AI runs locally on EACH client computer. The browser connects to 127.0.0.1:8000.
# The central Node server does not start or host Ollama.
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=127.0.0.1
AI_TEXT_MODEL=qwen3:4b-instruct
AI_VISION_MODEL=gemma3:4b
OLLAMA_ANSWER_KEY_TIMEOUT_SECONDS=240

# Cloud deployment (Render + Supabase). Local development can leave these unset.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=twineval-uploads
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_SERVICE_URL=https://twineval-ai.onrender.com

# Vercel build variables
# TWINEVAL_API_BASE=https://twineval-api.onrender.com
# TWINEVAL_AI_URL=https://twineval-ai.onrender.com
