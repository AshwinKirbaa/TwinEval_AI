# TwinEval AI configuration
# Network server settings
# 0.0.0.0 allows other computers on the same network to access this server.
HOST=0.0.0.0
PORT=5000

# SQLite: portable local database. No MySQL server is required.
# Relative paths are resolved from the project root.
DB_PATH=./database/twineval.db

# --- Authentication -------------------------------------------------------
# REQUIRED in production: a random secret of at least 32 characters used to
# sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development, if unset, a temporary per-process secret is used (sessions
# end when the server restarts). There is no built-in default.
JWT_SECRET=
NODE_ENV=development

# Cookies are marked Secure automatically when NODE_ENV=production.
# Override only if needed (e.g. HTTPS terminated by a proxy in staging).
# COOKIE_SECURE=true
# Set when running behind a reverse proxy so rate limiting sees client IPs
# ("true" trusts one proxy hop, or give a hop count / subnet).
# TRUST_PROXY=true
# Extra origins (comma separated) allowed to make credentialed cross-origin
# requests. Not needed when the frontend is served by this server.
# CORS_ORIGINS=https://app.example.com

# Optional rate-limit tuning (defaults shown).
# AUTH_LOGIN_MAX=10          # login attempts / 15 min / IP+email
# AUTH_REGISTER_MAX=10       # registrations / hour / IP
# AUTH_EMAIL_MAX=5           # reset / resend emails / hour / IP+email
# AUTH_LOCK_THRESHOLD=5      # failed logins before an account is locked
# AUTH_LOCK_MINUTES=15

# --- Email (verification + password reset) ---------------------------------
# PUBLIC_APP_URL is the base URL used in emailed links. REQUIRED in
# production (never derived from the request Host header there).
PUBLIC_APP_URL=http://localhost:5000
# Use an SMTP mailbox/app password; never commit the real password.
# For Gmail, SMTP_HOST defaults to smtp.gmail.com and may be omitted.
# If SMTP is not configured in development, no email is sent: verification
# and reset links are printed to the server console instead. In production,
# registration is refused while SMTP is unconfigured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-real-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=TwinEval AI <your-real-email@example.com>

# AI runs locally on EACH client computer. The browser connects to 127.0.0.1:8000.
# The central Node server does not start or host Ollama.
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=127.0.0.1
AI_ENGINE_MODEL=gemma3:4b
