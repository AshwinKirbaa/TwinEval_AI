# TwinEval AI configuration
# Network server settings
# 0.0.0.0 allows other computers on the same network to access this server.
HOST=0.0.0.0
PORT=5000

# SQLite: portable local database. No MySQL server is required.
# Relative paths are resolved from the project root.
DB_PATH=./database/twineval.db

# REQUIRED in production (NODE_ENV=production): at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development, if left unset, a random secret is generated and kept in database/.dev-jwt-secret.
JWT_SECRET=
# Lifetime of "Keep me signed in" sessions (persistent cookie) and of normal browser-session logins.
JWT_EXPIRES_IN=7d
JWT_SESSION_EXPIRES_IN=12h
NODE_ENV=development

# Set to the number of reverse proxies in front of Node (e.g. 1 on Render/nginx) so rate limiting
# sees real client IPs. Leave unset when running directly.
# TRUST_PROXY=1
# The frontend is served by this server, so CORS is off by default. Only set this if a separately
# hosted frontend must call the API (comma-separated origins; cookies are allowed for these).
# CORS_ORIGINS=https://app.example.com

# Email is REQUIRED for sign-up verification and password reset links. Without it, registration
# and "Forgot password" return a clear error instead of pretending an email was sent.
# Real email verification. Use an SMTP mailbox/app password; never commit
# the real password to source control.
PUBLIC_APP_URL=http://localhost:5000
# For Gmail, SMTP_HOST defaults to smtp.gmail.com and may be omitted.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-real-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=TwinEval AI <your-real-email@example.com>

# AI runs locally on EACH client computer. The browser connects to 127.0.0.1:8000.
# The central Node server does not start or host Ollama.
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=127.0.0.1
AI_ENGINE_MODEL=gemma3:4b
